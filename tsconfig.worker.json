{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "cloudflare-env.d.ts",
    "worker/**/*.ts",
    "app/lib/contributable-registry.ts",
    "app/lib/contribution-media.ts"
  ]
}
