# Copy this file to .env.local and fill in real values to run the
# Worker-backed forms and contribution flow locally.
#
#   cp .env.local.example .env.local
#
# Never commit .env.local — it is gitignored.

# --- Google Sign-In (client-side, via Google Identity Services) ---
# https://console.cloud.google.com/apis/credentials — create an OAuth 2.0
# Client ID of type "Web application". Add your dev origin
# (e.g. http://localhost:3001) to "Authorized JavaScript origins".
# No client secret needed: login is fully client-side; the backend only
# verifies the Google-signed ID token.
#
# The NEXT_PUBLIC_ prefix exposes this to the browser (required for the
# "Sign in with Google" button). The backend reuses it as the audience
# when verifying the token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- GitHub App (authors the contribution PRs) ---
# Create at: https://github.com/organizations/Deshi-Startup/settings/apps/new
#   (or under your user account settings → Developer settings → GitHub Apps)
# Repository permissions: Contents = Read & write, Pull requests = Read & write
# No webhooks needed. Install it on Deshi-Startup/deshistartup.
GITHUB_APP_ID=
# The PEM private key. Paste with real newlines, OR keep the \n escapes —
# both are handled. Keep it secret.
GITHUB_APP_PRIVATE_KEY=
# Numeric installation ID (from the app's install page URL, or the API).
GITHUB_INSTALLATION_ID=

# Comma-separated Google-account emails allowed to approve/reject proposed
# images and mute or ban abusive contributors. Keep this as a Cloudflare Worker
# runtime variable in production.
CONTRIBUTION_REVIEWER_EMAILS=

# --- Contact form ---
# Use the account-level verified Email Routing destination, not the public
# hello@ routing alias. Keep the real destination in the Worker secret only.
CONTACT_INBOX=verified-destination@example.com

# --- Media (images, screenshots, video posters) ---
# Images live in an R2 bucket, never in the repo. Nothing here is a secret:
# uploads use the maintainer's own `wrangler login`, so there is no R2 access
# key to keep. Defaults are in next.config.mjs / scripts/lib/media-lib.mjs and
# these only exist to override them.
#
# The bucket that `npm run media:upload` writes to.
# DESHI_R2_BUCKET=deshistartup-media
# Public host the bucket is served from. Set it to an empty value to self-host
# images from public/media instead (a fork with no bucket of its own).
# DESHI_MEDIA_BASE_URL=https://media.deshistartup.com
# Edge image resizing via /cdn-cgi/image is on by default (Transformations are
# enabled for the zone). Set to 0 to serve every image at full size instead.
# DESHI_MEDIA_TRANSFORM=0

# --- Optional overrides ---
# GITHUB_REPO=Deshi-Startup/deshistartup
