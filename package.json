{
  "name": "deshistartup",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:turbo": "node scripts/dev.mjs --turbopack",
    "build": "NODE_ENV=production next build",
    "build:worker": "DESHI_DEPLOY_TARGET=cloudflare-worker npm run build",
    "preview:worker": "npm run build:worker && wrangler dev --env-file .env.local",
    "deploy:worker": "npm run build:worker && wrangler deploy --keep-vars",
    "upload:worker": "npm run build:worker && wrangler versions upload --keep-vars",
    "check:worker": "npm run typecheck:worker && WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --outdir .wrangler/dry-run && node scripts/check-worker-size.mjs && node scripts/check-static-assets.mjs",
    "cf:typegen": "WRANGLER_WRITE_LOGS=false wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "pretypecheck:worker": "npm run cf:typegen",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "start": "npm run preview:worker",
    "scrape": "node scripts/scrape.js",
    "manifest": "node scripts/build-manifest.mjs",
    "contributors:refresh": "node scripts/build-contributors.mjs",
    "media:upload": "node scripts/media-upload.mjs",
    "media:posters": "node scripts/fetch-youtube-posters.mjs",
    "media:prune": "node scripts/media-prune.mjs",
    "lint:citations": "node scripts/citation-lint.mjs",
    "lint:media": "node scripts/media-lint.mjs",
    "test:citations": "node --experimental-strip-types --test app/lib/rehype-footnotes.test.mjs app/lib/contribution-markdown.test.mjs scripts/citation-lint.test.mjs",
    "test:media": "node --test scripts/media-lib.test.mjs",
    "backlog:status": "npm run manifest && node scripts/backlog-status.mjs",
    "lint:bangla": "node scripts/bangla-lint.mjs",
    "lint:routes": "node scripts/route-lint.mjs",
    "test:contribute": "node --experimental-strip-types --test app/lib/contributable-path.test.mjs app/lib/contribution-markdown.test.mjs app/lib/contribution-draft.test.mjs app/lib/contribution-media.test.mjs app/lib/clean-route.test.mjs",
    "test:contributors": "node --test scripts/contributor-data.test.mjs app/lib/contributor-leaderboard.test.mjs",
    "test:analytics": "node --experimental-strip-types --test app/lib/search-analytics.test.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "seo:indexnow:dry": "node scripts/submit-indexnow.mjs --dry-run",
    "predev": "node scripts/build-manifest.mjs",
    "prebuild": "node scripts/route-lint.mjs && node scripts/media-lint.mjs && node scripts/citation-lint.mjs && node scripts/build-manifest.mjs",
    "postbuild": "node scripts/postbuild-seo.mjs && node scripts/build-pagefind.mjs && node scripts/seo-audit.mjs"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "^7.21.2",
    "jose": "^6.2.8",
    "next": "^15.5.23",
    "nextra": "^4.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "cheerio": "^1.2.0",
    "pagefind": "^1.5.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "dompurify": "^3.4.13",
    "mermaid": "^11.16.1"
  }
}
