{
  "name": "deshistartup",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "NODE_ENV=production next build",
    "build:worker": "DESHI_DEPLOY_TARGET=cloudflare-worker opennextjs-cloudflare build",
    "preview:worker": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare deploy -- --keep-vars",
    "upload:worker": "opennextjs-cloudflare upload -- --keep-vars",
    "check:worker": "OPEN_NEXT_DEPLOY=true wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "scrape": "node scripts/scrape.js",
    "manifest": "node scripts/build-manifest.mjs",
    "media": "node scripts/build-media-manifest.mjs",
    "media:posters": "node scripts/fetch-youtube-posters.mjs",
    "lint:media": "node scripts/build-media-manifest.mjs && node scripts/media-lint.mjs",
    "backlog:status": "node scripts/backlog-status.mjs",
    "lint:bangla": "node scripts/bangla-lint.mjs",
    "lint:routes": "node scripts/route-lint.mjs",
    "test:contribute": "node --experimental-strip-types --test app/lib/contribution-markdown.test.mjs app/lib/contribution-draft.test.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "seo:indexnow:dry": "node scripts/submit-indexnow.mjs --dry-run",
    "predev": "node scripts/build-media-manifest.mjs && node scripts/build-manifest.mjs",
    "prebuild": "node scripts/route-lint.mjs && node scripts/build-media-manifest.mjs && node scripts/media-lint.mjs && node scripts/build-manifest.mjs",
    "postbuild": "node scripts/postbuild-seo.mjs && node scripts/build-pagefind.mjs && node scripts/seo-audit.mjs"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@milkdown/react": "^7.21.2",
    "jose": "^6.2.3",
    "next": "^15.1.3",
    "nextra": "^4.0.0",
    "nextra-theme-docs": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cheerio": "^1.2.0",
    "node-fetch": "^3.3.2",
    "pagefind": "^1.5.2",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3",
    "wrangler": "4.114.0"
  }
}
